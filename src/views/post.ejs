<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= post.title %></title>
  <link rel="stylesheet" href="/public/css/post.css">
</head>
<body>

<header class="site-nav">
  <a class="brand" href="/">Johnsi<span>Raani</span></a>
  <nav class="links">
    <a href="/">Home</a>
    <a href="/admin">Admin</a>
  </nav>
</header>

<main>
  <div class="breadcrumb"><a href="/">Home</a> / <%= post.title %></div>

  <span class="tag-pill">Blog</span>

  <h1 class="post-title"><%= post.title %></h1>

  <%
    const postDate = new Date(post.created_at.replace(' ', 'T') + 'Z');
    const formattedDate = postDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
    const wordCount = post.body.trim().split(/\s+/).filter(Boolean).length;
    const readMinutes = Math.max(1, Math.round(wordCount / 200));
  %>

  <div class="post-meta">
    <div class="avatar"></div>
    <div>
      <div class="author-name">Johnsi Raani</div>
      <div><%= formattedDate %> &middot; <%= readMinutes %> min read</div>
    </div>
  </div>

  <div class="hero-image" role="img" aria-label="Featured image for <%= post.title %>"></div>

  <article class="post-body">
    <% post.body.split(/\n+/).filter(line => line.trim()).forEach(paragraph => { %>
      <p><%= paragraph %></p>
    <% }) %>
  </article>

  <hr class="divider">

  <div class="author-card">
    <div class="avatar"></div>
    <div>
      <h3>Written by Johnsi Raani</h3>
      <p>Full-cycle developer, writing about building software end-to-end.</p>
    </div>
  </div>
</main>

</body>
</html>
