<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= post.title %></title>
  <link rel="stylesheet" href="/post.css">
</head>
<body class="post-page">

<header class="site-nav">
  <a class="brand" href="/">Johnsi<span>Raani</span></a>
  <nav class="links">
    <a href="/">Home</a>
    <a href="/admin">Admin</a>
  </nav>
</header>

<main class="post-main">
  <div class="breadcrumb"><a href="/">Home</a> / <a href="/">Posts</a> / <%= post.title %></div>

  <h1 class="post-title"><%= post.title %></h1>

  <div class="post-meta">
    <div class="avatar"></div>
    <div>
      <div class="author-name">Johnsi Raani</div>
      <div><%= post.created_at %> &middot; <%= readingMinutes %> min read</div>
    </div>
  </div>

  <div class="hero-image" role="img" aria-label="Featured image placeholder"></div>

  <article class="post-body">
    <% paragraphs.forEach(p => { %>
      <p><%= p %></p>
    <% }) %>
  </article>

  <hr class="divider">

  <div class="author-card">
    <div class="avatar"></div>
    <div>
      <h3>Written by Johnsi Raani</h3>
      <p>Thanks for reading &mdash; more posts on the way.</p>
    </div>
  </div>
</main>

</body>
</html>
