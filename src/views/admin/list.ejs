<%- include('../partials/header', { title: 'Admin · Posts' }) %>

<section class="admin-panel">
  <div class="admin-header">
    <h1>Manage Posts</h1>
    <a href="/admin/new" class="btn">+ New Post</a>
  </div>

  <% if (posts.length === 0) { %>
    <p>No posts yet. <a href="/admin/new">Create your first post</a>.</p>
  <% } else { %>
    <table class="admin-table">
      <thead>
        <tr><th>Title</th><th>Created</th><th>Actions</th></tr>
      </thead>
      <tbody>
        <% posts.forEach(post => { %>
        <tr>
          <td><a href="/post/<%= post.id %>"><%= post.title %></a></td>
          <td><%= new Date(post.created_at).toLocaleDateString() %></td>
          <td>
            <a href="/admin/edit/<%= post.id %>">Edit</a>
            <form action="/admin/delete/<%= post.id %>" method="POST" class="inline-form">
              <button type="submit" class="link-btn">Delete</button>
            </form>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</section>

<%- include('../partials/footer') %>
