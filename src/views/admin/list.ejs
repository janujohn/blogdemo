<%- include('../partials/head') %>
  <h1>Admin</h1>
  <p><a href="/admin/new">+ New post</a></p>
  <% if (posts.length === 0) { %>
    <p class="empty">No posts yet.</p>
  <% } else { %>
    <table class="admin-table">
      <thead>
        <tr><th>Title</th><th>Updated</th><th></th></tr>
      </thead>
      <tbody>
        <% posts.forEach(post => { %>
          <tr>
            <td><a href="/posts/<%= post.slug %>"><%= post.title %></a></td>
            <td class="date"><%= post.updated_at %></td>
            <td class="actions">
              <a href="/admin/<%= post.id %>/edit">Edit</a>
              <form method="POST" action="/admin/<%= post.id %>/delete" class="inline-form">
                <button type="submit">Delete</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
<%- include('../partials/foot') %>
