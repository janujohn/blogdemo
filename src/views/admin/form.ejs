<%- include('../partials/head') %>
  <h1><%= post ? 'Edit post' : 'New post' %></h1>
  <form method="POST" action="<%= post ? `/admin/${post.id}/edit` : '/admin/new' %>" class="post-form">
    <label for="title">Title</label>
    <input type="text" id="title" name="title" value="<%= post ? post.title : '' %>" required>

    <label for="body">Body</label>
    <textarea id="body" name="body" rows="12" required><%= post ? post.body : '' %></textarea>

    <button type="submit"><%= post ? 'Save' : 'Create' %></button>
  </form>
<%- include('../partials/foot') %>
