<%- include('partials/head') %>
  <h1>Posts</h1>
  <% if (posts.length === 0) { %>
    <p class="empty">No posts yet.</p>
  <% } else { %>
    <ul class="post-list">
      <% posts.forEach(post => { %>
        <li>
          <a href="/posts/<%= post.slug %>"><%= post.title %></a>
          <span class="date"><%= post.created_at %></span>
        </li>
      <% }) %>
    </ul>
  <% } %>
<%- include('partials/foot') %>
